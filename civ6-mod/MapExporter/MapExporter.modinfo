<?xml version="1.0" encoding="utf-8"?>
<Mod id="8f2fae10-6c40-4b62-a8d1-3b4f0c2b9e01" version="1">
  <Properties>
    <Name>Map Exporter (Development Calculator)</Name>
    <Teaser>Dumps the current map to Lua.log for the Civ 6 Development Calculator.</Teaser>
    <Description>On game load, prints every plot (terrain, features, resources, rivers, lakes, natural wonders) to Lua.log as CIV6MAP| lines. Paste the log into the Development Calculator's Import panel. No gameplay changes; safe to enable on existing saves.</Description>
    <Authors>civ6-development-calculator</Authors>
    <AffectsSavedGames>0</AffectsSavedGames>
  </Properties>
  <InGameActions>
    <AddUserInterfaces id="MapExporter_UI">
      <Properties>
        <Context>InGame</Context>
      </Properties>
      <File>MapExporter.xml</File>
    </AddUserInterfaces>
    <AddUserInterfaces id="MapExporter_LiveSync">
      <Properties>
        <Context>InGame</Context>
      </Properties>
      <File>LiveSync.xml</File>
    </AddUserInterfaces>
  </InGameActions>
  <Files>
    <File>MapExporter.xml</File>
    <File>MapExporter.lua</File>
    <File>LiveSync.xml</File>
    <File>LiveSync.lua</File>
  </Files>
</Mod>
