{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "compact",
        "hooks": [
          {
            "type": "command",
            "command": "python -X utf8 -c \"import pathlib; p = pathlib.Path('.claude/HANDOFF.md'); print('=== POST-COMPACTION HANDOFF (.claude/HANDOFF.md) ===\\n' + p.read_text(encoding='utf-8') if p.exists() else 'No .claude/HANDOFF.md handoff file present.')\""
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python -X utf8 .claude/hooks/no_heredoc.py"
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(export PYTHONUTF8=1)",
      "Bash(python gpu/parity_test.py *)",
      "Bash(python gpu/parity_test.py)",
      "Bash(npx tsc --noEmit)",
      "Bash(npx vite-node scripts/export-gpu.ts)",
      "Bash(python gpu/rollout.py *)",
      "Bash(python gpu/battery.py *)",
      "Bash(npx vitest run *)",
      "Bash(npm test)",
      "Bash(npm run gpu:replay)",
      "Bash(npm run gpu:export)",
      "Bash(tasklist *)"
    ],
    "deny": [
      "Bash(sleep:*)"
    ]
  }
}
