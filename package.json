{
  "name": "civ6-development-calculator",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "preview:map": "vite-node scripts/preview.ts",
    "rl:build": "vite build -c vite.rl.config.ts",
    "rl:train": "npm run rl:build && node dist-rl/train.js",
    "rl:eval": "npm run rl:build && node dist-rl/evaluate.js",
    "rl:train:dev": "vite-node scripts/train.ts",
    "test": "vitest run",
    "gpu:export": "vite-node scripts/export-gpu.ts",
    "gpu:rollout": "python3 gpu/rollout.py",
    "gpu:replay": "vite-node scripts/replay-gpu.ts"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.0",
    "vitest": "^3.0.0"
  }
}
